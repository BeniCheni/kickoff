{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run sync -- --check)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"],
            "timeout": 8
          }
        ]
      }
    ]
  }
}
