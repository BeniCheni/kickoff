{
  "name": "@kickoff/studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kickoff Moments Studio, local and offline. Not a release of the reader.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "test:contract": "vitest run test/schema.test.ts test/embeddings.test.ts test/catalog-contract.test.ts test/catalog-publish.test.ts test/isolation.test.ts test/schema-boundary.test.ts test/secrets.test.ts",
    "migrate": "tsx db/migrate.ts",
    "seed:demo": "tsx db/seed-demo.ts",
    "cli": "tsx cli.ts",
    "studio": "vite build --config ui/vite.config.ts && tsx server/main.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@kickoff/catalog": "file:../packages/kickoff-catalog",
    "@kickoff/demo": "file:../packages/kickoff-demo",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-pgvector": "0.0.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
